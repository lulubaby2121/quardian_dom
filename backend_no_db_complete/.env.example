JWT_SECRET=
PORT=4000

# Gere uma chave Base64 aleatória de 32 bytes. Obrigatória para iniciar o backend.
CAMERA_ENCRYPTION_KEY=
# Opcional e temporária: chave antiga CAMERA_CREDENTIALS_KEY para migrar registros cifrados.
CAMERA_LEGACY_ENCRYPTION_KEY=
# Câmeras IP / MediaMTX. Preencha somente no servidor autorizado; nunca no frontend.
CAMERA_ALLOWED_NETWORKS=
CAMERA_ALLOWED_RTSP_PORTS=554,8554,322
CAMERA_REVIEWER_IDS=
CAMERA_RECORDING_RETENTION_DAYS=30
MEDIAMTX_ALLOWED_HOSTS=
MEDIAMTX_INTERNAL_HOSTS=mediamtx
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_API_USER=guardian-api
MEDIAMTX_API_PASSWORD=
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
MEDIAMTX_HLS_USER=guardian-viewer
MEDIAMTX_HLS_PASSWORD=
MEDIAMTX_RECORDINGS_PATH=/recordings
RECORDINGS_DIRECTORY=/recordings

# Banco de dados SQLite por padrão. Defina mysql para usar MySQL e ajuste as credenciais.
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=rootpw
DB_NAME=angel_guardian

# Para sqlite, remova/defina DB_TYPE=sqlite ou deixe sem variáveis DB_* (padrão sqlite)